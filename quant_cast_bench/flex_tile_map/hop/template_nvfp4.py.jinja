{# nvfp4 dim-K template (per-tensor outer scale): 1x16 inner blocks ALONG COLUMNS, e4m3 inner
   scale, fp4-packed qdata (two e2m1 per byte). Unlike the deepseek/mxfp8 dim-M templates this
   reduces along the LAST dim in 16-groups with NO transpose, and it takes a REPLICATE aux input
   (the per-tensor outer scale, a scalar loaded once). The emitter body:
     - reshapes x_var (BLOCK_M, BLOCK_N) -> (BLOCK_M, BLOCK_N//16, 16), reduces the 16-group amax
       to the e4m3 inner scale, scales+clamps the data to +-6, and packs two e2m1 per byte via the
       SM100 hardware `cvt.rn.satfinite.e2m1x2.f32` (tl.inline_asm_elementwise);
     - writes `scale_var` (BLOCK_M, BLOCK_N//16) e4m3 and `qdata_var` (BLOCK_M, BLOCK_N//2) packed.

   (A hand-written near-duplicate of the dim-M templates; the family will be unified once the
   template is parameterized over group width / reduction axis / packing -- see future_ideas.md.)

   The body is str.replace'd into this source in the lowering BEFORE jinja rendering.

   Inductor input/output convention (INVERTED vs the dim-M templates: the primary autotuned output
   is the e4m3 SCALE, not qdata):
     input_nodes  = [X, Q, OUTER]  (Q is the mutated primary-data output: the fp4-packed qdata,
                                    layout (M, N//2) float4_e2m1fn_x2; OUTER is the scalar per-tensor
                                    outer scale, a REPLICATE aux)
     primary output = scale        layout (M, N//16) e4m3; allocated via layout
   qdata is the mutated input rather than the primary output because the autotuner zero_()s the
   primary buffer to benchmark each choice, and fill/zero_ is unimplemented for float4_e2m1fn_x2.
#}
{{def_kernel("X", "Q", "OUTER")}}
    pid_m = tl.program_id(0)  # over input row-tiles (BLOCK_M)
    pid_n = tl.program_id(1)  # over input col-tiles (BLOCK_N)

    stride_xm, stride_xn = {{stride("X")}}
    stride_qm, stride_qn = {{stride("Q")}}

    M = {{size("X", 0)}}
    N = {{size("X", 1)}}
    NH = N // 2   # packed qdata columns: two e2m1 per byte
    NG = N // 16  # scale columns: one e4m3 per 16-element inner block

    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)  # input rows
    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)  # input cols
    x_offs = offs_m[:, None] * stride_xm + offs_n[None, :] * stride_xn
    x_mask = (offs_m[:, None] < M) & (offs_n[None, :] < N)
    x_var = tl.load(X + x_offs, mask=x_mask, other=0.0)
    aux0_var = tl.load(OUTER)  # per-tensor outer scale (scalar, REPLICATE aux)

    # ---- spliced FxTritonEmitter body: reads x_var + aux0_var, writes qdata_var + scale_var ----
    __EMITTER_BODY__
    # ---- end spliced body ----

    # qdata store (mutated input): (M, N//2) fp4-packed (two e2m1 per byte), row-major, NO transpose.
    # rows = input rows (offs_m); cols = this tile's packed columns (BLOCK_N//2).
    offs_nh = pid_n * (BLOCK_N // 2) + tl.arange(0, BLOCK_N // 2)
    q_offs = offs_m[:, None] * stride_qm + offs_nh[None, :] * stride_qn
    q_mask = (offs_m[:, None] < M) & (offs_nh[None, :] < NH)
    tl.store(Q + q_offs, qdata_var, mask=q_mask)

    # primary output: scale (M, N//16) e4m3, row-major. dim0 = M indexed by input rows (offs_m),
    # dim1 = this tile's 16-groups.
    idx_m = offs_m[:, None]
    offs_ng = pid_n * (BLOCK_N // 16) + tl.arange(0, BLOCK_N // 16)
    idx_ng = offs_ng[None, :]
    out_mask = (idx_m < M) & (idx_ng < NG)
    {{ store_output(("idx_m", "idx_ng"), "scale_var", "out_mask", val_shape=("BLOCK_M", "BLOCK_N // 16")) }}
